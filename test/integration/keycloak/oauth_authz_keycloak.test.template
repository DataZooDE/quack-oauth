# name: oauth_authz_keycloak.test
# description: quack_oauth_check_authorization wired through the session_id → Principal cache (S-13b, R-S-7 / R-S-8).
# group: [sql]
#
# Template -- run via `make integration_keycloak`. Substitutes @ISSUER@,
# @JWKS_URI@, @TOKEN@.
#
# Demonstrates the wiring end-to-end against a live Keycloak token:
#
# 1. Unknown session_id -> deny (default-deny when no Principal cached).
# 2. After quack_oauth_check_token(session_id, ...) succeeds, the
#    session_id -> Principal cache is populated. This is the load-bearing
#    handoff between authentication and authorization that quack relies
#    on (since check_authorization's signature doesn't carry the token).
# 3. With a Principal in the cache, EvaluateDefaultPolicy(Scan) runs.
#    Keycloak's default ROPC token to alice doesn't include the
#    `quack:read` scope (it carries `email profile` by default), so the
#    default policy per R-S-8 correctly DENIES.
#
# In a production deployment the operator would either:
#   - Configure a custom client scope `quack:read` (and assign to the
#     client / user)
#   - Or point the SECRET's `policy_table` at a SQL table holding rules
#     that recognise the realm's actual scope names (see the
#     oauth_policy_table_keycloak.test for that path).
# Both are out of scope here; the integration test proves the *wiring*.

require quack_oauth

statement ok
CREATE SECRET rs (
    TYPE quack_oauth_server,
    issuer '@ISSUER@',
    jwks_uri '@JWKS_URI@'
);

statement ok
SET quack_oauth_server_secret_name = 'rs';

# 1. Unknown session: deny (no Principal cached → default-deny).
query I
SELECT quack_oauth_check_authorization('session-not-in-cache', 'SELECT 1');
----
false

# 2. Successful token validation via the 3-arg form populates the cache.
query I
SELECT quack_oauth_check_token('sess-1', '@TOKEN@', 'server-psk');
----
true

# 3. With Principal cached, default policy is applied. The token doesn't
#    carry `quack:read`, so the default policy denies Scan. This proves
#    BOTH that the cache populated (otherwise this would also fail with
#    "no principal") AND that the policy is correctly restrictive.
#    The deny is observable: false (not an error), so the cache lookup
#    found the principal and the policy evaluated to Deny.
query I
SELECT quack_oauth_check_authorization('sess-1', 'SELECT * FROM t');
----
false

# 4. Action routing exercise (S-13c): different query shapes route to
#    different Actions, but all deny because the principal lacks the
#    write-class scope `quack:write` per R-S-8. We verify that the
#    DetectAction path runs by hitting each shape; a SQL-table policy
#    (see oauth_policy_table_keycloak.test) distinguishes allow/deny
#    by action.
query I
SELECT quack_oauth_check_authorization('sess-1', 'ATTACH ''quack:rs'' AS r');
----
false

query I
SELECT quack_oauth_check_authorization('sess-1', 'COPY t TO ''out.csv''');
----
false

query I
SELECT quack_oauth_check_authorization('sess-1', 'COPY t FROM ''in.csv''');
----
false

query I
SELECT quack_oauth_check_authorization('sess-1', 'PRAGMA quack_serve(''rs'')');
----
false

# 5. Distinct session_id: still deny -- the cache is keyed by session_id.
query I
SELECT quack_oauth_check_authorization('sess-completely-different', 'SELECT 1');
----
false

# 6. After populating sess-2, the deny pattern is repeated -- proving
#    the cache works for that session too (otherwise both calls would
#    be identical "no principal" denies, but in step 5 we DON'T call
#    check_token first, in step 7 we DO).
query I
SELECT quack_oauth_check_token('sess-2', '@TOKEN@', 'server-psk');
----
true

# 7. sess-2 now has a Principal, default policy denies same as sess-1.
query I
SELECT quack_oauth_check_authorization('sess-2', 'SELECT 1');
----
false

# Cleanup.
statement ok
DROP SECRET rs;
