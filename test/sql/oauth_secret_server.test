# name: test/sql/oauth_secret_server.test
# description: Server-side SECRET TYPE quack_oauth_server registration and round-trip (S-3, R-S-11).
# group: [sql]

require quack_oauth

# R-S-11: a CREATE SECRET ... TYPE quack_oauth_server carries
# issuer/audience/jwks_uri/policy_table. These configure the resource server.
statement ok
CREATE SECRET rs (
    TYPE quack_oauth_server,
    issuer 'https://idp.example.com/realms/main',
    audience 'api://quack.example.com',
    jwks_uri 'https://idp.example.com/realms/main/protocol/openid-connect/certs',
    policy_table 'main.quack_oauth_policies'
);

query III
SELECT name, type, provider FROM duckdb_secrets() WHERE name = 'rs';
----
rs	quack_oauth_server	config

# All four fields are non-sensitive per R-S-10; they must be observable.
query I
SELECT secret_string LIKE '%https://idp.example.com/realms/main%'
   AND secret_string LIKE '%api://quack.example.com%'
   AND secret_string LIKE '%main.quack_oauth_policies%'
FROM duckdb_secrets() WHERE name = 'rs';
----
true

# Cleanup.
statement ok
DROP SECRET rs;

# Malformed jwks_uri containing control chars is rejected
statement error
CREATE SECRET bad_rs (
    TYPE quack_oauth_server,
    jwks_uri 'https://idp.example.com/certs
injection'
);
----
Invalid Input Error: quack_oauth: jwks_uri contains invalid or control characters

statement error
CREATE SECRET bad_rs2 (
    TYPE quack_oauth_server,
    jwks_uri 'ftp://idp.example.com/certs'
);
----
Invalid Input Error: quack_oauth: jwks_uri must begin with 'https://' (or 'http://localhost' for local development)

# Plain http:// to external host is rejected
statement error
CREATE SECRET bad_rs_http (
    TYPE quack_oauth_server,
    jwks_uri 'http://idp.example.com/certs'
);
----
Invalid Input Error: quack_oauth: jwks_uri must use 'https://' (plain 'http://' is only allowed for localhost development)

# Plain http:// to localhost is accepted for local development
statement ok
CREATE SECRET ok_localhost_rs (
    TYPE quack_oauth_server,
    jwks_uri 'http://localhost:8080/realms/main/protocol/openid-connect/certs'
);

statement ok
DROP SECRET ok_localhost_rs;

# Spoofed localhost prefix hosts must be rejected
statement error
CREATE SECRET bad_spoof1 (
    TYPE quack_oauth_server,
    jwks_uri 'http://localhost.evil.example/certs'
);
----
Invalid Input Error: quack_oauth: jwks_uri must use 'https://' (plain 'http://' is only allowed for localhost development)

statement error
CREATE SECRET bad_spoof2 (
    TYPE quack_oauth_server,
    jwks_uri 'http://127.0.0.1.evil.example/certs'
);
----
Invalid Input Error: quack_oauth: jwks_uri must use 'https://' (plain 'http://' is only allowed for localhost development)

statement error
CREATE SECRET bad_spoof3 (
    TYPE quack_oauth_server,
    jwks_uri 'http://localhost@evil.example/certs'
);
----
Invalid Input Error: quack_oauth: jwks_uri must not contain userinfo ('@')

# HTTPS with userinfo (@) must be rejected
statement error
CREATE SECRET bad_rs_userinfo (
    TYPE quack_oauth_server,
    jwks_uri 'https://user:pass@idp.example.com/certs'
);
----
Invalid Input Error: quack_oauth: jwks_uri must not contain userinfo ('@')

# tenant_or_realm with plaintext non-localhost http must be rejected
statement error
CREATE SECRET bad_rs_tenant_http (
    TYPE quack_oauth_server,
    tenant_or_realm 'http://evil.com/realms/main'
);
----
Invalid Input Error: quack_oauth: tenant_or_realm must use 'https://' (plain 'http://' is only allowed for localhost development)

# tenant_or_realm with control characters must be rejected
statement error
CREATE SECRET bad_rs_tenant_ctrl (
    TYPE quack_oauth_server,
    tenant_or_realm 'tenant
injection'
);
----
Invalid Input Error: quack_oauth: tenant_or_realm contains invalid or control characters




