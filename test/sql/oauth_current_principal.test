# name: test/sql/oauth_current_principal.test
# description: quack_oauth_current_principal() exposes cached session principals (R-S-6).
# group: [sql]

require quack_oauth

# The function is registered with the documented column shape, even
# before any check_token has populated session_principals.
query I
SELECT count(*) > 0 FROM duckdb_functions()
WHERE function_name = 'quack_oauth_current_principal' AND function_type = 'table';
----
true

# Column shape contract: session_id, subject, issuer, scopes, exp.
query IIIII
SELECT typeof(session_id), typeof(subject), typeof(issuer),
       typeof(scopes), typeof(exp)
FROM quack_oauth_current_principal()
LIMIT 1;
----
