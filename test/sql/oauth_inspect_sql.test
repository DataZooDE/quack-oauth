query I
SELECT unsafe OR list_contains(objects, 'schema:hidden') FROM quack_oauth_inspect_sql('CREATE SCHEMA hidden');
----
true

query I
SELECT unsafe FROM quack_oauth_inspect_sql('SELECT nextval(''s'')');
----
true

query I
SELECT unsafe FROM quack_oauth_inspect_sql('SELECT currval(''s'')');
----
true

query I
SELECT unsafe FROM quack_oauth_inspect_sql('CREATE FUNCTION f(x) AS x');
----
true

query I
SELECT unsafe FROM quack_oauth_inspect_sql('PRAGMA database_list');
----
true

query I
SELECT unsafe OR list_contains(objects, 'fn:duckdb_databases') FROM quack_oauth_inspect_sql('SELECT * FROM duckdb_databases()');
----
true

# Safe controls must remain available to ordinary BI clients.
query I
SELECT NOT unsafe FROM quack_oauth_inspect_sql('SET threads=4');
----
true

query I
SELECT NOT unsafe AND len(objects)=0 FROM quack_oauth_inspect_sql('SHOW TABLES');
----
true

query I
SELECT NOT unsafe AND len(objects)=0 FROM quack_oauth_inspect_sql('SELECT * FROM information_schema.tables');
----
true

query I
SELECT NOT unsafe AND len(objects)=0 FROM quack_oauth_inspect_sql('SELECT * FROM duckdb_tables()');
----
true

query I
SELECT list_contains(objects, 'main.secret') AND NOT list_contains(objects, 'main.z') FROM quack_oauth_inspect_sql('WITH z AS (SELECT * FROM secret), secret AS (SELECT 1) SELECT * FROM z');
----
true
