# name: test/sql/oauth_quack_swap.test
# description: 3-arg quack_oauth_check_token overload + wiring as quack's authentication callback (S-9, R-S-1 redux).
# group: [sql]
#
# This test exercises the actual callback-name swap that activates
# quack-oauth in front of quack. It requires the `quack` extension to
# be available -- the `require quack` directive tells sqllogictest to
# SKIP the test (rather than fail) when it isn't, so CI runs don't
# break for environments that haven't pre-installed quack.
#
# Local dev: install quack once via `duckdb -c "INSTALL quack;"`. Some
# DuckDB unittest builds also look in `build/release/repository/<ver>/<plat>/`
# -- see CLAUDE.md's "require <ext> vs LOAD <ext>" gotcha.
#
# Canonical end-to-end coverage of the swap lives in the Python+uv
# harness at e2e/ (`make e2e`), which boots a real quack server with
# our callbacks wired in and drives traffic through the wire protocol.

require quack

require quack_oauth

# Both overloads of quack_oauth_check_token are registered (works
# without quack too, but kept here so the assertion lands alongside
# the swap it exercises).
query II
SELECT parameter_types::VARCHAR, return_type
FROM duckdb_functions()
WHERE function_name = 'quack_oauth_check_token'
ORDER BY parameter_types::VARCHAR;
----
[VARCHAR, VARCHAR, VARCHAR]	BOOLEAN
[VARCHAR]	BOOLEAN

# Default authentication function is still quack's built-in.
query I
SELECT current_setting('quack_authentication_function');
----
quack_check_token

# Operator opts in to quack-oauth by pointing the setting at our function.
# This is the *actual* swap mechanism quack provides -- it's name-based,
# replacing the draft requirements.md's REPLACE_ON_CONFLICT design.
statement ok
SET quack_authentication_function = 'quack_oauth_check_token';

query I
SELECT current_setting('quack_authentication_function');
----
quack_oauth_check_token

# The 3-arg overload exists at the function-set level: it short-circuits
# on a forbidden algorithm and returns false (the session_id and auth_string
# args are ignored; only the third VARCHAR drives validation).
statement ok
CREATE SECRET rs (
    TYPE quack_oauth_server,
    issuer 'https://idp.test',
    jwks_uri 'https://idp.nonexistent.invalid/jwks'
);

statement ok
SET quack_oauth_server_secret_name = 'rs';

query I
SELECT quack_oauth_check_token('session-abc', 'not-a-jwt', 'server-psk');
----
false

# HS256 token -- the 3-arg path goes through the same DisallowedAlgorithm
# branch the 1-arg path takes (R-S-3); no HTTP touched.
query I
SELECT quack_oauth_check_token('s', 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c', 'server-psk');
----
false

# Restore the default so this test doesn't leak state to its peers.
statement ok
SET quack_authentication_function = 'quack_check_token';

statement ok
DROP SECRET rs;
