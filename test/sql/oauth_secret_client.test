# name: test/sql/oauth_secret_client.test
# description: Client-side SECRET TYPE quack_oauth registration and round-trip (S-3, R-C-1).
# group: [sql]

require quack_oauth

# R-C-1: the client SECRET type MUST be registered with the documented fields.
# Without the extension loaded, the type is unknown. After LOAD, CREATE SECRET succeeds.
# (Pre-load assertion is implicit in the require-then-create ordering.)

# Full-fledged secret with every R-C-1 field populated.
statement ok
CREATE SECRET full_client (
    TYPE quack_oauth,
    issuer 'https://idp.example.com/realms/main',
    client_id 'client-abc',
    client_secret 'super-secret-value-xyz',
    audience 'api://quack.example.com',
    scope 'openid quack:read quack:write',
    device_authorization_endpoint 'https://idp.example.com/device',
    token_endpoint 'https://idp.example.com/token',
    redirect_listener_port 7333,
    access_token 'leaked-access-token-eyJ',
    refresh_token 'leaked-refresh-token-rt',
    expires_at '2099-12-31T23:59:59Z'
);

# The secret is discoverable and has the right type.
query III
SELECT name, type, provider FROM duckdb_secrets() WHERE name = 'full_client';
----
full_client	quack_oauth	config

# Sensitive fields MUST be redacted in the textual representation (R-N-5).
# The raw values we passed in MUST NOT appear in secret_string.
query I
SELECT secret_string NOT LIKE '%super-secret-value-xyz%'
   AND secret_string NOT LIKE '%leaked-access-token-eyJ%'
   AND secret_string NOT LIKE '%leaked-refresh-token-rt%'
FROM duckdb_secrets() WHERE name = 'full_client';
----
true

# Non-sensitive fields ARE visible in secret_string -- this is the observability surface
# operators rely on (R-N-12 spirit; sub/iss/aud/kid are not sensitive per R-S-10).
query I
SELECT secret_string LIKE '%client-abc%'
   AND secret_string LIKE '%api://quack.example.com%'
   AND secret_string LIKE '%https://idp.example.com/realms/main%'
FROM duckdb_secrets() WHERE name = 'full_client';
----
true

# Regression: DuckDB's `CREATE SECRET (..., scope '...')` parser consumes the
# `scope` keyword as the API-level URL-scope BEFORE our custom named-parameter
# handler runs. Without the input.scope fallback in CreateClientSecret, the
# OAuth scope is silently stripped from the map, and AcquireTokenClientCredentials
# omits it from the request body -- IdPs that strictly enforce scope (Entra v2.0,
# Google) reject the request with `AADSTS90014: required field 'scope' is missing`.
# The fix surfaces the scope back into secret_map, so it shows TWICE in
# secret_string: once as the DuckDB-API scope, once as our custom field.
query I
SELECT (length(secret_string) - length(replace(secret_string, 'scope=openid quack:read quack:write', ''))) / length('scope=openid quack:read quack:write') = 2
FROM duckdb_secrets() WHERE name = 'full_client';
----
true

# Minimum-fields variant: just an externally injected access_token (R-C-1, Wasm path R-C-6).
statement ok
CREATE SECRET injected_only (
    TYPE quack_oauth,
    access_token 'externally-injected-token',
    expires_at '2099-12-31T23:59:59Z'
);

query I
SELECT secret_string NOT LIKE '%externally-injected-token%'
FROM duckdb_secrets() WHERE name = 'injected_only';
----
true

# Minimum-fields variant: client_credentials (client_id + client_secret + token_endpoint).
statement ok
CREATE SECRET m2m (
    TYPE quack_oauth,
    client_id 'm2m-client',
    client_secret 'm2m-secret',
    token_endpoint 'https://idp.example.com/token',
    audience 'api://quack.example.com'
);

# Cleanup so subsequent test runs start from an empty state.
statement ok
DROP SECRET full_client;

statement ok
DROP SECRET injected_only;

statement ok
DROP SECRET m2m;
