# name: test/sql/oauth_settings.test
# description: All quack_oauth_* settings are registered with the requirement-driven defaults (S-2).
# group: [sql]

require quack_oauth

# R-N-12: every extension setting MUST be discoverable via duckdb_settings().
# Defaults are sourced from:
#   R-S-1  quack_oauth_enabled = false
#   R-S-2  quack_oauth_validation_mode = 'jwks'
#   R-S-3  quack_oauth_clock_skew_s = 60
#   R-S-4  quack_oauth_jwks_min_refresh_s = 30
#   R-S-5  quack_oauth_introspect_cache_s = 30
#   R-S-7  quack_oauth_policy_default = 'deny'
#   R-S-12 quack_oauth_provider = 'generic'
#   R-C-2  quack_oauth_renew_skew_s = 60
#   R-N-4  quack_oauth_trust_plaintext = false
#   S-7b.2 quack_oauth_server_secret_name = '' (validator's server-SECRET selector)
query II
SELECT name, value FROM duckdb_settings() WHERE name LIKE 'quack_oauth%' ORDER BY name;
----
quack_oauth_clock_skew_s	60
quack_oauth_enabled	false
quack_oauth_introspect_cache_s	30
quack_oauth_jwks_min_refresh_s	30
quack_oauth_policy_default	deny
quack_oauth_provider	generic
quack_oauth_renew_skew_s	60
quack_oauth_server_secret_name	(empty)
quack_oauth_trust_plaintext	false
quack_oauth_validation_mode	jwks

# SET roundtrip on a boolean.
statement ok
SET quack_oauth_enabled = true;

query I
SELECT current_setting('quack_oauth_enabled');
----
true

# SET roundtrip on a varchar.
statement ok
SET quack_oauth_validation_mode = 'introspect';

query I
SELECT current_setting('quack_oauth_validation_mode');
----
introspect

# SET roundtrip on an integer.
statement ok
SET quack_oauth_jwks_min_refresh_s = 120;

query I
SELECT current_setting('quack_oauth_jwks_min_refresh_s');
----
120
