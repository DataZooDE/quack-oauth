# Entra ID credentials for transcript capture (slice S-11b).
#
# Copy to .env.entra (gitignored) and fill in real values.
# .env.entra MUST NEVER be committed.
#
# For CI, mirror these into GitHub Actions repository secrets with the
# same names (Settings → Secrets and variables → Actions). The
# capture/replay workflow reads them from env, not from .env.entra.

# Tenant where the quack-oauth app is registered (the "Directory (tenant) ID"
# from the Azure portal). Public; OK to commit elsewhere.
QUACK_OAUTH_ENTRA_TENANT_ID=

# The "Application (client) ID" from the Azure portal. Public.
QUACK_OAUTH_ENTRA_CLIENT_ID=

# The Value column of a client secret under Certificates & secrets.
# Sensitive -- treat like a password.
QUACK_OAUTH_ENTRA_CLIENT_SECRET=

# Scope to request. For Microsoft Graph application permissions this is
# always the `/.default` form -- Entra picks the granted Application
# permissions automatically.
QUACK_OAUTH_ENTRA_SCOPE=https://graph.microsoft.com/.default
