# GitHub OAuth App credentials for the live quack-oauth demo.
#
# Copy to .env.demo (gitignored) and fill in real values.
#
# Setup steps:
#   1. github.com -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
#      (Must be an OAuth App, NOT a GitHub App -- quack-oauth's `github_check`
#      validation mode uses POST /applications/{client_id}/token which is the
#      OAuth-App-only endpoint.)
#   2. Application name:     quack-oauth demo (whatever you like)
#      Homepage URL:         http://localhost:8000/
#      Callback URL:         http://localhost:8000/oauth/callback
#   3. Note the Client ID (starts with `Iv1.` or `Ov23li...`).
#   4. Generate a client secret -- copy the value once (GitHub shows it exactly once).

# OAuth App client_id. Public-ish (visible in any OAuth redirect URL).
GITHUB_DEMO_CLIENT_ID=

# OAuth App client_secret. Sensitive -- treat like a password.
GITHUB_DEMO_CLIENT_SECRET=

# Port the demo binds aiohttp to. Default 8000. Change if you have a clash.
GITHUB_DEMO_PORT=8000

# When set to 1, load quack_oauth from the locally-built
# ../build/release/extension/quack_oauth/quack_oauth.duckdb_extension
# rather than installing from get.erpl.io. Useful for dev iteration
# on the extension itself.
QUACK_OAUTH_LOCAL=0
