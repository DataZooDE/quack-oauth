# Google OAuth 2.0 Web Application credentials for the live quack-oauth demo.
#
# Copy to .env.demo (gitignored) and fill in real values.
#
# Setup steps:
#   1. Google Cloud Console -> APIs & Services -> Credentials
#      https://console.cloud.google.com/apis/credentials
#   2. Create OAuth client ID:
#        Application type:           Web application
#        Name:                       quack-oauth demo (whatever you like)
#        Authorized JavaScript origins:  http://localhost:8000
#        Authorized redirect URIs:       http://localhost:8000/oauth/callback
#   3. Copy the resulting Client ID (looks like `1234567890-abc...xyz.apps.googleusercontent.com`)
#      and Client secret.
#   4. On the OAuth consent screen for the project, make sure your Google
#      account is in the test-users list (or the app is published) so you
#      can complete the flow without a verification review.

# OAuth 2.0 client_id (ends in `.apps.googleusercontent.com`).
GOOGLE_DEMO_CLIENT_ID=

# OAuth 2.0 client secret. Sensitive -- treat like a password.
GOOGLE_DEMO_CLIENT_SECRET=

# Port the demo binds aiohttp to. Default 8000. Must match the
# Authorized redirect URI on the OAuth client.
GOOGLE_DEMO_PORT=8000

# When set to 1, load quack_oauth from the locally-built
# ../build/release/extension/quack_oauth/quack_oauth.duckdb_extension
# rather than installing from get.erpl.io. Useful for dev iteration
# on the extension itself.
QUACK_OAUTH_LOCAL=0
