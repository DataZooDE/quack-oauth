# Google Cloud credentials for transcript capture (slice S-11b).
#
# Copy to .env.google (gitignored) and fill in real values.
# .env.google MUST NEVER be committed.
#
# For CI, mirror the same key file as a GitHub Actions secret (encoded
# as base64 or via Secret Manager) -- the capture/replay workflow can
# decode it back to a temp file at runtime.

# Path to the service-account JSON key downloaded from Google Cloud
# Console (IAM & Admin → Service Accounts → Keys → Add key → JSON).
# Relative to the repo root, or absolute. Sensitive: the JSON contains
# the service account's RSA private key.
QUACK_OAUTH_GOOGLE_KEY_FILE=./datazoo-landingpage-0dfa68900167.json

# OAuth scope to request. The capture script uses the JWT-bearer flow
# (RFC 7523) to mint an access token; the resulting token's `aud` and
# `scope` in tokeninfo will reflect this. Cloud Platform read-only is
# the minimum-risk default and only requires the service account to
# exist (no roles attached).
QUACK_OAUTH_GOOGLE_SCOPE=https://www.googleapis.com/auth/cloud-platform.read-only
